#!/usr/bin/env bash
# The guard every PR passes: it fails on an email address, a secret or session data in any file git would commit,
# and names each one.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0

files() { git ls-files -z --cached --others --exclude-standard; }
found() { # $1 what, $2 grep's file:line:match lines
  [ -n "$2" ] || return 0
  sed "s|^|check-public: $1: |" <<< "$2" >&2
  fail=1
}

# The two senders a commit trailer names: a GitHub noreply address and Claude's.
found email "$(files | xargs -0 grep -nIoE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' | grep -vE '@users\.noreply\.github\.com$|:noreply@anthropic\.com$' || true)"
found session "$(files | xargs -0 grep -nIE '^#{1,3} Turn [0-9]+ ·|"tool_use[_]id"|"type": ?"tool_use"' || true)"

tree=$(mktemp -d); trap 'rm -rf "$tree"' EXIT
files | rsync -a --from0 --files-from=- . "$tree"
gitleaks dir "$tree" --no-banner --redact --log-level error >&2 || fail=1

exit $fail
